NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test_apk

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Comma-separated allowed frontend origins. Leave empty in development to allow any localhost port.
CORS_ORIGIN=
